# =========================================
# API Market KASU — .htaccess de proteccion
# =========================================

RewriteEngine On

# Bloquear archivos sensibles
<Files ".env">
  Require all denied
</Files>
<Files "error.log">
  Require all denied
</Files>
<FilesMatch "error_log$">
  Require all denied
</FilesMatch>

# Bloquear archivos sensibles (logs, reportes, variables de entorno, documentacion interna)
<FilesMatch "\.(log|txt|env|md|sql)$">
  Require all denied
</FilesMatch>

# Bloquear listado de directorios
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Headers de seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

# Bloquear acceso web directo al directorio de helpers/funciones (relativo y portable).
# ^Funciones/ aplica tanto en kasu.com.mx/apimarket/ como en apimarket.kasu.com.mx/.
RewriteRule ^Funciones/ - [F,L]

# Reglas de enrutamiento para metadatos e imagenes NFT (DEBEN ir antes de la regla generica .php)
# /api/nft/metadata/1156 o /api/nft/metadata/1156.json -> /api/nft/metadata.php?id=1156
RewriteRule ^api/nft/metadata/([0-9]+)(\.json)?$ api/nft/metadata.php?id=$1 [QSA,L]

# /api/nft/image/1156 o /api/nft/image/1156.png -> /api/nft/image.php?id=1156
RewriteRule ^api/nft/image/([0-9]+)(\.png)?$ api/nft/image.php?id=$1 [QSA,L]

# Extensiones .php automaticas (con seguridad de archivo real)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]